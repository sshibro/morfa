+/// The WGSL without its comments, indentation and blank lines (Morfa, vendor/README.md: the sources are a third of
+/// the renderer module's bytes; WGSL has no string literals, so a `//` always opens a comment).
+fn minify_wgsl(source: &str) -> String {
+    let mut out = String::with_capacity(source.len());
+    for line in source.lines() {
+        let code = match line.find("//") {
+            Some(at) => &line[..at],
+            None => line,
+        };
+        let code = code.trim();
+        if code.is_empty() {
+            continue;
+        }
+        out.push_str(code);
+        out.push('\n');
+    }
+    out
+}
