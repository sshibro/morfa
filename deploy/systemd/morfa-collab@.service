# One Morfa collab node (crates/collab, binary morfa-collab). The instance is the node's name: morfa-collab@a reads
# /etc/morfa/collab.env (shared: ticket key, internal secret, database, S3) and /etc/morfa/collab-a.env (its own
# MORFA_COLLAB_NODE and MORFA_COLLAB_ADDR on 127.0.0.1 or the private interface; never public — Caddy routes only
# /n/<node>/collab/* to it, see deploy/caddy/morfa-routes.caddy).
#
# Stop = drain (crates/collab/src/drain.rs): SIGTERM → /healthz 503 "draining" → every open
# file checkpointed → `bye {shutdown}` → leases released → exit. MORFA_COLLAB_DRAIN_TIMEOUT_MS (25 s) is below
# TimeoutStopSec, so systemd's SIGKILL only ever meets a node that hung; even then every acked op is in the journal.
[Unit]
Description=Morfa collab node %i
After=network-online.target postgresql.service
Wants=network-online.target
PartOf=morfa.target

[Service]
Type=simple
Slice=morfa.slice
User=morfa
Group=morfa
WorkingDirectory=/srv/morfa/data
EnvironmentFile=/etc/morfa/collab.env
EnvironmentFile=/etc/morfa/collab-%i.env
Environment=OTEL_SERVICE_NAME=morfa-collab
# Plain log lines for journald and Loki (no terminal colours).
Environment=NO_COLOR=1
ExecStart=/srv/morfa/current/bin/morfa-collab serve
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30
LimitNOFILE=262144
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/morfa/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=morfa.target
