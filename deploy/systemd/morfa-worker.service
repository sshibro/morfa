# The api's background process (server/worker.ts): trash sweep, account erasure. Exactly one
# runs per database (it holds a PostgreSQL advisory lock; a second one exits), so it is not a template.
[Unit]
Description=Morfa worker
After=network-online.target postgresql.service
Wants=network-online.target
PartOf=morfa.target

[Service]
Type=simple
Slice=morfa.slice
User=morfa
Group=morfa
WorkingDirectory=/srv/morfa/current
EnvironmentFile=/etc/morfa/api.env
Environment=NODE_ENV=production
Environment=MORFA_INSTANCE=worker
ExecStart=/usr/local/bin/node --enable-source-maps --import tsx server/worker.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/morfa/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=morfa.target
