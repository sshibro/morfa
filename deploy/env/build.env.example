# /etc/morfa/build.env — read by scripts/deploy/build.sh (when present) for the release's web build. Not a secret: only public
# origins. Unset, a production build uses the production name (vite.config.ts PRODUCTION_APP_ORIGIN).
#   VITE_APP_ORIGIN        the app (the desktop shell, links the app builds for itself): https://app.morfa.example
VITE_APP_ORIGIN=https://app.morfa.example
