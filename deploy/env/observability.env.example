# /etc/morfa/observability.env — the observability compose (deploy/observability/docker-compose.yml) on the same VM.
# Grafana listens on 127.0.0.1:3000 only: reach it through an SSH tunnel.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME
# Cores of the observability containers (bench-ru keeps them off the Morfa slice's cores in the 4-core profile).
OBS_CPUSET=4-7
# PostgreSQL exporter: a monitoring role with pg_monitor (created by provision-bench.sh).
DATA_SOURCE_NAME=postgresql://morfa_monitor:CHANGE_ME@127.0.0.1:5432/morfa?sslmode=disable
# Alert delivery: the directory with the operator's alertmanager.yml; unset: the repository's (drops them).
# ALERTMANAGER_CONFIG_DIR=/etc/morfa/alertmanager
