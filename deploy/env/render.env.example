# /etc/morfa/render.env — lane B4's render/export service (crates/render-service, binary morfa-render; deploy/systemd/
# morfa-render.service). Mode 600, owner root. NEVER commit the real file. Every variable: crates/render-service/src/main.rs.
# api reaches it with DESIGN_PDF_ENGINE=service, DESIGN_RENDER_URL=http://<this address>, DESIGN_RENDER_SECRET=<the secret>.
MORFA_RENDER_ADDR=127.0.0.1:3440
# The bearer secret of POST /internal/render (api's DESIGN_RENDER_SECRET; at least 16 characters). Unset: every job is refused.
MORFA_RENDER_INTERNAL_SECRET=CHANGE_ME_64_HEX
# The catalogue font files (scripts/copy-fonts.ts puts them in the release's public/fonts).
MORFA_RENDER_FONTS_DIR=/srv/morfa/current/public/fonts
# Worker threads (default: one per core; the 8 vCPU app VM shares them with api and collab, so 4 there).
MORFA_RENDER_WORKERS=4
# Jobs waiting beyond the running ones (16), the longest a job may take (60 s), the largest request (512 MiB).
MORFA_RENDER_QUEUE=16
MORFA_RENDER_TIMEOUT_MS=60000
RUST_LOG=info
