# /etc/morfa/s3.env — the bucket every service and the backups use. bench-ru: MinIO (provisional stand-in). Production and,
# once the operator creates it, bench-ru: Timeweb Cloud S3 (path-style, SigV4, region ru-1). Never committed.
S3_ENDPOINT=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_BUCKET=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# "minio" marks every D/S row measured against it "provisional: MinIO stand-in".
S3_KIND=timeweb
