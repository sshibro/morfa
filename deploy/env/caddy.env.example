# /etc/morfa/caddy.env — read by caddy.service (drop-in deploy/systemd/caddy.service.d/morfa.conf).
# Production (Caddyfile.morfa + morfa-sites.caddy): the app's name, the base domain's (collab-a., collab-b. and updates. are
# made from it) and the ACME account's e-mail (expiry notices).
MORFA_DOMAIN=app.morfa.example
MORFA_MARKETING_DOMAIN=morfa.example
MORFA_ACME_EMAIL=ops@example.invalid
# bench-ru (Caddyfile.bench): the VM's public IP for the https site with Caddy's internal CA.
MORFA_BENCH_IP=203.0.113.10
# Upstreams (defaults in deploy/caddy/morfa-routes.caddy): space-separated api processes, one address per collab node.
MORFA_API_UPSTREAMS=127.0.0.1:3401 127.0.0.1:3402
MORFA_COLLAB_A=127.0.0.1:3421
MORFA_COLLAB_B=127.0.0.1:3422
MORFA_APP_DIR=/srv/morfa/current/dist/app
# Desktop installers (morfa.example/download/…) and the updater's files (updates.morfa.example): kept across releases.
MORFA_DOWNLOADS_DIR=/srv/morfa/downloads
MORFA_UPDATES_DIR=/srv/morfa/updates
