# /etc/morfa/api.env — the api processes (morfa-api@N) and the worker. Mode 600, owner root, read by systemd. NEVER commit
# the real file. Every variable of the repository's .env.example may go here; these are the ones a deploy must set.
# bench-ru: scripts/deploy/provision-bench.sh writes it with generated secrets. Production: the operator fills it.

# The app's https origin (no path). Bench: https://<bench IP>. Production: https://app.morfa.example (the landing is
# https://morfa.example, a separate static site: deploy/caddy/morfa-sites.caddy).
APP_ORIGIN=https://app.morfa.example
# Caddy is the only client: trust its X-Forwarded-For.
TRUST_PROXY=1
DATA_DIR=/srv/morfa/data

# PostgreSQL (deploy/postgres/init-roles.sh roles, three passwords). Production: the database VM's private address over verified TLS
# (its CA from the pgtls step); a cluster on this machine may use 127.0.0.1 with sslmode=disable.
MORFA_DATABASE_URL=postgresql://morfa_runtime:CHANGE_ME@CHANGE_ME_DB_PRIVATE_IP:5432/morfa?sslmode=verify-full
MORFA_MIGRATION_DATABASE_URL=postgresql://morfa_migration:CHANGE_ME@CHANGE_ME_DB_PRIVATE_IP:5432/morfa?sslmode=verify-full
MORFA_BACKUP_DATABASE_URL=postgresql://morfa_backup:CHANGE_ME@CHANGE_ME_DB_PRIVATE_IP:5432/morfa?sslmode=verify-full
MORFA_DATABASE_CA_CERT_FILE=/etc/morfa/pg-ca.crt
# Pool per api process (20 measured better than 10: A1 p95 92 → 83 ms). Processes × pool must stay under max_connections.
MORFA_DATABASE_POOL_MAX=20
# Two or more api processes: live co-editing streams (legacy path) fan out through PostgreSQL LISTEN/NOTIFY.
DESIGN_LIVE_FANOUT=postgres

# Sign-in has no settings (docs/authentication.md): a person types a name. There are no passwords, so this deployment must sit on a
# private network or behind your own authenticating reverse proxy.
# The operators (docs/admin.md, server/admin/operators.ts): account ids or addresses, comma separated; an account's address is its name in
# lower case at name.invalid (docs/authentication.md). Empty: nobody.
#MORFA_OPERATORS=operator@name.invalid
# Allowlist of the design tool (docs/authentication.md): comma-separated account ids (users.id, the `id` of GET /api/auth/me) or name
# addresses (`anna@name.invalid`). Empty: every account.
#DESIGN_TOOL_ACCOUNTS=<account id>,<account id>
# The MCP server (docs/mcp-server.md): a person's own assistant (Claude, Cursor, ChatGPT) reads their files at APP_ORIGIN/mcp after
# they allow it. Off unless set; MCP_ACCOUNTS: ids or name addresses, unset or empty is nobody, `*` is everyone.
#ENABLE_MCP_SERVER=1
#MCP_ACCOUNTS=<account id>
# Tool calls one account may make in a UTC day, all its assistants together (default 2000).
#MCP_DAILY_CALLS=2000
# Let a connected assistant change the files its person may edit too (docs/mcp-server.md §Editing). Off unless set.
#ENABLE_MCP_EDITS=1
# "Marketplaces" Performance Loop (docs/marketplaces.md §Performance Loop): Wildberries and Ozon by the seller's API key, publishing,
# numbers on the canvas, A/B tests. Needs HOSTING_ENCRYPTION_KEY and APP_ORIGIN (Ozon downloads pictures from it). Off unless set.
#ENABLE_MARKETPLACE_API=1
# Outgoing mail (server/mail.ts): the support chat's letters. Unset: nothing is sent.
#MORFA_SMTP_URL=smtps://<user>:<password>@<host>:465
#MORFA_MAIL_FROM=Morfa <team@morfa.example>

# Co-editing on collab (docs/BACKEND.md §7). Nodes: name=private URL|public base.
# The public base is the node's own name (collab-<node>.morfa.example, deploy/caddy/morfa-sites.caddy); the edge's
# wss://app.morfa.example/n/<node> also works (bench-ru, which has no domain, uses that one).
DESIGN_COLLAB_NODES=a=http://127.0.0.1:3421|wss://collab-a.morfa.example,b=http://127.0.0.1:3422|wss://collab-b.morfa.example

# The switches and their launch values (every one is read per request, a restart applies it):
#   DESIGN_COLLAB            legacy (default: SSE + PATCH) | shadow (PATCH authoritative, mirrored to collab) | rust (WebSocket to
#                            collab). Launch: legacy, then shadow, then rust per account/team (DESIGN_COLLAB_ACCOUNTS), then
#                            for everyone — each step is `scripts/deploy/rollback.sh <host> --collab <mode>` away from the last.
#   DESIGN_COLLAB_ACCOUNTS   per account or team overrides: <id>=<mode>, comma-separated (empty: none)
#   DESIGN_SERVER_LAYOUT     0 (default) | 1: the server lays out merged edits (on once a team's fonts are on the server)
#   DESIGN_BIG_FILES         0 (default; off until the GPU renderer meets C3/C11) | 1: big-file caps, pages on demand
#                            (collab reads MORFA_BIG_FILES: keep both the same)
DESIGN_COLLAB=legacy
DESIGN_COLLAB_ACCOUNTS=
DESIGN_SERVER_LAYOUT=0
DESIGN_BIG_FILES=0
# Export (docs/design-tool.md §Export, docs/BACKEND.md §4): who writes the vector PDF. `service` = lane B4's render service
# (morfa-render, deploy/env/render.env.example) natively on every core, off api's event loop; a document it refuses or a
# service that does not answer goes to Chromium (IMPORT_CHROMIUM_PATH), so production keeps Chromium installed.
# Other values: chromium (the default when unset), wasm (the same writer in api's process).
ENABLE_DESIGN_PDF_EXPORT=1
DESIGN_PDF_ENGINE=service
DESIGN_RENDER_URL=http://127.0.0.1:3440
# = render.env MORFA_RENDER_INTERNAL_SECRET (at least 16 characters; `openssl rand -hex 32`).
DESIGN_RENDER_SECRET=CHANGE_ME_64_HEX
# IMPORT_CHROMIUM_PATH=/usr/bin/chromium
DESIGN_COLLAB_INTERNAL_SECRET=CHANGE_ME_64_HEX
# Ed25519 seed of the socket tickets (`morfa-collab keygen`: MORFA_COLLAB_TICKET_PRIVATE_KEY); collab holds the public half.
DESIGN_COLLAB_TICKET_KEY=CHANGE_ME
# Checkpoints and pictures in S3 (api reads collab's checkpoints; crates/blobs layout: ckpt/, img/, thumb/).
DESIGN_BLOBS=s3
DESIGN_S3_ENDPOINT=https://s3.timeweb.cloud
DESIGN_S3_REGION=ru-1
DESIGN_S3_BUCKET=CHANGE_ME
DESIGN_S3_ACCESS_KEY=CHANGE_ME
DESIGN_S3_SECRET_KEY=CHANGE_ME

# Observability (server/observability): spans to Tempo on the private network; METRICS_PORT is set per unit (940N).
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=morfa-api
MORFA_BUILD_COMMIT=CHANGE_ME_BY_RELEASE
