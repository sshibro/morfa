# /etc/morfa/collab.env — shared by every collab node of the host (morfa-collab@<node>). Mode 600, owner root. NEVER commit
# the real file. Per node: /etc/morfa/collab-<node>.env (collab-node.env.example). Every variable: crates/collab/src/main.rs.

# api's ticket public key (base64url), the shared internal secret, api's private URL for ACL re-validation.
MORFA_COLLAB_TICKET_KEY=CHANGE_ME
MORFA_COLLAB_INTERNAL_SECRET=CHANGE_ME_64_HEX
MORFA_COLLAB_API_URL=http://127.0.0.1:3401
# The app origin the upgrade's Origin must be (comma-separated).
MORFA_COLLAB_ORIGINS=https://app.morfa.example
# The journal, leases and checkpoint records: the api's database, runtime role. crates/journal connects
# without TLS (NoTls): only loopback or the private network may carry it.
MORFA_COLLAB_PG_URL=postgresql://morfa_runtime:CHANGE_ME@CHANGE_ME_DB_PRIVATE_IP:5432/morfa?sslmode=disable
# Checkpoints in S3 (path-style; Timeweb: https://s3.timeweb.cloud, region ru-1). bench-ru: MinIO at http://127.0.0.1:9000.
MORFA_COLLAB_S3_ENDPOINT=https://s3.timeweb.cloud
MORFA_COLLAB_S3_REGION=ru-1
MORFA_COLLAB_S3_BUCKET=CHANGE_ME
MORFA_COLLAB_S3_ACCESS_KEY=CHANGE_ME
MORFA_COLLAB_S3_SECRET_KEY=CHANGE_ME
# Shards: one single-threaded runtime per thread (default one per core). Two nodes on the 8 vCPU app VM share it with api
# and render: 3 each. MORFA_COLLAB_MEMORY_LIMIT_MB: over this resident set the node opens no new file (api sends idle files
# to the other node; its own files stay) — about 40 % of the VM's RAM per node with two nodes on 16 GB.
MORFA_COLLAB_SHARDS=3
MORFA_COLLAB_MEMORY_LIMIT_MB=6144
# Big files (api's DESIGN_BIG_FILES; keep both the same): 0 until the GPU renderer meets C3/C11.
MORFA_BIG_FILES=0
# Drain on stop (crates/collab/src/drain.rs): notice for api's health check, then the deadline (below TimeoutStopSec=30).
MORFA_COLLAB_DRAIN_NOTICE_MS=2500
MORFA_COLLAB_DRAIN_TIMEOUT_MS=25000
# Op spans to Tempo (1 % + every op over 20 ms).
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
MORFA_TRACE_SAMPLE=0.01
MORFA_TRACE_SLOW_MS=20
RUST_LOG=info
