{
  "name": "morfa",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/copy-fonts.ts && concurrently -k -n api,worker,app \"PORT=3400 tsx watch server/index.ts\" \"tsx watch server/worker.ts\" \"vite --host 127.0.0.1\"",
    "start": "NODE_ENV=production tsx server/index.ts",
    "worker": "tsx server/worker.ts",
    "build": "npm run build:assets && npm run check && npm run build:app && npm run performance:budgets",
    "build:assets": "tsx scripts/copy-fonts.ts",
    "build:app": "vite build --mode app",
    "check": "tsx scripts/typecheck/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:design": "tsx --test tests/design-*.test.ts",
    "test:pg": "tsx scripts/postgresql/test.ts",
    "test:e2e": "playwright test",
    "gate": "scripts/gate.sh",
    "fonts": "tsx scripts/copy-fonts.ts",
    "performance:budgets": "node scripts/performance/budgets.mjs",
    "targets": "tsx scripts/bench/targets.ts",
    "targets:md": "tsx scripts/bench/targets-md.ts",
    "bench:files": "tsx scripts/bench/gen-file.ts --all",
    "db:migrate": "tsx scripts/postgresql/migrate.ts",
    "db:test-cluster": "node --import tsx scripts/postgresql/test-cluster.mjs",
    "admin:seed-demo": "tsx scripts/admin/seed-demo.ts",
    "format": "prettier --write \"server/**/*.ts\" \"scripts/postgresql/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"server/**/*.ts\" \"scripts/postgresql/**/*.{ts,mjs}\""
  },
